# Thin stopping medium: recoils punch through the 10 um layer.
# Compares recoil energy/velocity before and after the medium.
/detector/customZ 14
/detector/customA 30
/detector/customDensity 1.25 g/cm3
/detector/customSymbol Si
/detector/targetThickness 10 um

/run/initialize

/reaction/thinTarget false
/reaction/targetZ 14
/reaction/targetA 30
/reaction/recoilZ 14
/reaction/recoilA 32
/reaction/ejectileZ 8
/reaction/ejectileA 16

/gun/particle ion
/gun/ion 8 18
/gun/energy 26 MeV

/run/beamOn 10000
