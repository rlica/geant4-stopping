30Si(18O,16O)32Si at 23 MeV
NAMELIST
 &FRESCO hcm=0.05 rmatch=45.0 rintp=0.20 hnl=0.10 rnl=8.0 centre=0.0
  jtmin=0.0 jtmax=80.0 absend=-1.0
  thmin=0.0 thmax=180.0 thinc=0.25
  iter=1 nnu=48 chans=1 xstabl=1 elab=23.0 /

 &PARTITION namep='o18' massp=18.0 zp=8 namet='si30' masst=30.0 zt=14 nex=1 /
 &STATES jp=0.0 bandp=1 ep=0.0 cpot=1 jt=0.0 bandt=1 et=0.0 /

 &PARTITION namep='o16' massp=16.0 zp=8 namet='si32' masst=32.0 zt=14
  qval=3.60 nex=2 /
 &STATES jp=0.0 bandp=1 ep=0.0 cpot=2 jt=0.0 bandt=1 et=0.0 /
 &STATES jp=0.0 bandp=1 ep=0.0 cpot=2 jt=0.0 bandt=1 et=6.0 /
 &PARTITION /

 ! Entrance optical potential: PLACEHOLDER Woods-Saxon, not a fitted potential.
 &POT kp=1 ap=18.0 at=30.0 rc=1.20 /
 &POT kp=1 type=1 p1=50.0 p2=1.17 p3=0.65 p4=25.0 p5=1.17 p6=0.70 /

 ! Exit optical potential: PLACEHOLDER Woods-Saxon, not a fitted potential.
 &POT kp=2 ap=16.0 at=32.0 rc=1.20 /
 &POT kp=2 type=1 p1=50.0 p2=1.17 p3=0.65 p4=25.0 p5=1.17 p6=0.70 /

 ! 2n-cluster binding potential in 18O = 16O + 2n.
 &POT kp=3 at=16.0 rc=1.20 /
 &POT kp=3 type=1 p1=50.0 p2=1.25 p3=0.65 /

 ! 2n-cluster binding potential in 32Si = 30Si + 2n.
 &POT kp=4 at=30.0 rc=1.20 /
 &POT kp=4 type=1 p1=50.0 p2=1.25 p3=0.65 /

 ! Remnant/core-core potential; use entrance geometry as a starter.
 &POT kp=5 ap=18.0 at=30.0 rc=1.20 /
 &POT kp=5 type=1 p1=50.0 p2=1.17 p3=0.65 p4=25.0 p5=1.17 p6=0.70 /
 &POT /

 ! Simplified S=0, L=0 dineutron-cluster overlaps.
 ! be values are approximate: S2n(18O)~12.19 MeV; S2n(32Si,g.s.)~15.79 MeV.
 ! For Ex=6 MeV, use be~9.79 MeV for the final overlap.
 &OVERLAP kn1=1 ic1=1 ic2=2 in=1 kind=0 nn=1 l=0 sn=0.0 j=0.0
  kbpot=3 be=12.19 isc=1 ipc=0 /
 &OVERLAP kn1=2 ic1=2 ic2=1 in=2 kind=3 nn=1 l=0 sn=0.0 ia=1 ib=1 j=0.0
  kbpot=4 be=15.79 isc=1 ipc=0 /
 &OVERLAP kn1=3 ic1=2 ic2=1 in=3 kind=3 nn=1 l=0 sn=0.0 ia=1 ib=2 j=0.0
  kbpot=4 be=9.79 isc=1 ipc=0 /
 &OVERLAP /

 ! Post-form finite-range one-step cluster transfer.
 &COUPLING icto=-2 icfrom=1 kind=7 ip1=0 ip2=-1 ip3=5 /
 &CFP in=1 ib=1 ia=1 kn=1 a=1.0 /
 &CFP in=2 ib=1 ia=1 kn=2 a=1.0 /
 &CFP in=3 ib=2 ia=1 kn=3 a=1.0 /
 &CFP /
 &COUPLING /
